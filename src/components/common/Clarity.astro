---
// Microsoft Clarity – heatmapy + session recordings (CRO książki, Sprint 1 2026-07).
//
// ID PROJEKTU JEST W REPO, NIE W .env (zmiana 2026-08-23). Powód: identyfikator i tak
// trafia do HTML każdego odwiedzającego (jest publiczny z definicji), a trzymany
// wyłącznie w gitignorowanym .env znikał po cichu z każdego builda spoza głównego
// checkoutu – Clarity było nieobecne w produkcji od 14.07 do 23.08.2026 i nikt tego
// nie zauważył, bo brak skryptu nie psuje strony. Ten sam wzorzec co GTM-PKRLVW2G,
// zaszyty wprost w Analytics.astro.
//
// Zmiana projektu Clarity: podmień stałą poniżej (i zbuduj + zdeployuj). Zmienna
// środowiskowa PUBLIC_CLARITY_ID nadal działa jako nadpisanie – przydatna, gdy
// chcesz wypchnąć build na inny projekt bez commita.
//
// RODO: skrypt ładuje się WYŁĄCZNIE gdy cookie pz_consent ma analytics=true
// (Consent Mode v2 – ConsentBanner.astro). Brak zgody = zero requestów do clarity.ms.
// CSP: public/_headers musi mieć clarity.ms w script-src i connect-src.
// Build: aios-workspace/builds/2026-07-05-ksiazka-sprint1/
const CLARITY_PROJECT_ID = 'xi4d9iurcz';
const clarityId = (import.meta.env.PUBLIC_CLARITY_ID as string | undefined) || CLARITY_PROJECT_ID;
---

{
  clarityId && (
    <script is:inline define:vars={{ clarityId }}>
      (function () {
        function hasAnalyticsConsent() {
          try {
            const parts = document.cookie ? document.cookie.split(';') : [];
            for (let i = 0; i < parts.length; i++) {
              const c = parts[i].trim();
              if (c.indexOf('pz_consent=') === 0) {
                const value = decodeURIComponent(c.substring('pz_consent='.length));
                const consent = JSON.parse(value);
                return consent && consent.analytics === true;
              }
            }
          } catch {
            /* malformed cookie = no consent */
          }
          return false;
        }
        function loadClarity() {
          // Oficjalny snippet Microsoft Clarity – trzymamy 1:1 z dokumentacją dostawcy.
          // `arguments` jest częścią mechanizmu kolejki (c[a].q) odtwarzanej przez tag clarity.ms;
          // NIE zamieniać na rest params (ryzyko cichego rozjazdu z vendorem przy re-copy).
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                // eslint-disable-next-line prefer-rest-params
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', clarityId);
        }
        // Load-on-consent-at-pageload: user, który dopiero co kliknął zgodę,
        // zostanie objęty od następnej odsłony (ConsentBanner nie emituje eventu;
        // świadomy trade-off – heatmapy nie wymagają 100% pokrycia sesji).
        if (hasAnalyticsConsent()) {
          loadClarity();
        }
      })();
    </script>
  )
}
